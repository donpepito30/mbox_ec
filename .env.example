GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# TMDb API Configurations (Bearer Token Authentication - Read Access Token)
NEXT_PUBLIC_TMDB_READ_ACCESS_TOKEN="your_tmdb_v4_read_access_token_here"
NEXT_PUBLIC_TMDB_BASE_URL="https://api.themoviedb.org/3"
VITE_TMDB_READ_ACCESS_TOKEN="your_tmdb_v4_read_access_token_here"
