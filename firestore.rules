rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Bloqueo global de seguridad por defecto (Zero-Trust)
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'jj863620@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'email', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'role', 'status', 'statusReason', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid.size() > 0 && data.uid.size() <= 128
        && data.email is string && data.email.size() > 0 && data.email.size() <= 256
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 128))
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1024))
        && (!('role' in data) || (data.role == 'SUPER_ADMIN' || data.role == 'ADMIN' || data.role == 'USER'))
        && (!('status' in data) || (data.status == 'ACTIVE' || data.status == 'PENDING' || data.status == 'SUSPENDED'))
        && (!('statusReason' in data) || (data.statusReason is string && data.statusReason.size() <= 256))
        && data.createdAt is string && data.createdAt.size() <= 64
        && data.updatedAt is string && data.updatedAt.size() <= 64;
    }

    function isValidFavorite(data) {
      return data.keys().hasAll(['userId', 'mediaId', 'mediaType', 'title', 'addedAt'])
        && data.keys().hasOnly(['userId', 'mediaId', 'mediaType', 'title', 'posterPath', 'backdropPath', 'voteAverage', 'releaseDate', 'addedAt'])
        && data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128
        && data.mediaId is string && data.mediaId.size() > 0 && data.mediaId.size() <= 64
        && (data.mediaType == 'movie' || data.mediaType == 'tv')
        && data.title is string && data.title.size() > 0 && data.title.size() <= 256
        && (!('posterPath' in data) || (data.posterPath is string && data.posterPath.size() <= 512))
        && (!('backdropPath' in data) || (data.backdropPath is string && data.backdropPath.size() <= 512))
        && (!('voteAverage' in data) || (data.voteAverage is number))
        && (!('releaseDate' in data) || (data.releaseDate is string && data.releaseDate.size() <= 32))
        && data.addedAt is string && data.addedAt.size() <= 64;
    }

    function isValidAuthSettings(data) {
      return data.keys().hasAll(['requireAdminApproval', 'maintenanceMode', 'updatedAt'])
        && data.keys().hasOnly(['requireAdminApproval', 'maintenanceMode', 'updatedAt', 'updatedBy'])
        && data.requireAdminApproval is bool
        && data.maintenanceMode is bool
        && data.updatedAt is string && data.updatedAt.size() <= 64
        && (!('updatedBy' in data) || (data.updatedBy is string && data.updatedBy.size() <= 256));
    }

    function isValidSecurityLog(data) {
      return data.keys().hasAll(['id', 'timestamp', 'type', 'severity', 'message'])
        && data.keys().hasOnly(['id', 'timestamp', 'type', 'severity', 'message', 'emailMasked'])
        && data.id is string && data.id.size() <= 128
        && data.timestamp is string && data.timestamp.size() <= 64
        && data.type is string && data.type.size() <= 64
        && (data.severity == 'INFO' || data.severity == 'WARN' || data.severity == 'CRITICAL')
        && data.message is string && data.message.size() <= 512
        && (!('emailMasked' in data) || (data.emailMasked is string && data.emailMasked.size() <= 128));
    }

    // Reglas de seguridad para perfiles de usuario y administracion RBAC
    match /users/{userId} {
      allow get: if (isOwner(userId) || isSuperAdmin()) && isValidId(userId);
      allow list: if isSuperAdmin();
      allow create: if ((isOwner(userId) && incoming().uid == userId) || isSuperAdmin()) && isValidId(userId) && isValidUserProfile(incoming());
      allow update: if isValidId(userId) && isValidUserProfile(incoming()) && (
        isSuperAdmin() ||
        (
          isOwner(userId) &&
          incoming().uid == existing().uid &&
          incoming().createdAt == existing().createdAt &&
          (!('role' in incoming()) || incoming().role == existing().role) &&
          (!('status' in incoming()) || incoming().status == existing().status)
        )
      );
      allow delete: if (isOwner(userId) || isSuperAdmin()) && isValidId(userId);

      // Subcoleccion privada de favoritos y Mi Lista
      match /favorites/{favoriteId} {
        allow get, delete: if isOwner(userId) && isValidId(userId) && isValidId(favoriteId);
        allow list: if isOwner(userId) && isValidId(userId);
        allow create: if isOwner(userId) && isValidId(userId) && isValidId(favoriteId) && isValidFavorite(incoming()) && incoming().userId == userId;
        allow update: if isOwner(userId) && isValidId(userId) && isValidId(favoriteId) && isValidFavorite(incoming()) && incoming().userId == userId && incoming().mediaId == existing().mediaId && incoming().addedAt == existing().addedAt;
      }
    }

    // Configuraciones globales de acceso y politicas (solo Super Admin puede escribir)
    match /settings/{settingId} {
      allow get: if isSignedIn() && isValidId(settingId);
      allow list: if isSuperAdmin();
      allow create, update: if isSuperAdmin() && isValidId(settingId) && isValidAuthSettings(incoming());
      allow delete: if isSuperAdmin() && isValidId(settingId);
    }

    // Registro de auditoria de seguridad inmutable
    match /security_logs/{logId} {
      allow get, list: if isSuperAdmin() && isValidId(logId);
      allow create: if isSignedIn() && isValidId(logId) && isValidSecurityLog(incoming());
      allow update, delete: if isSuperAdmin() && isValidId(logId);
    }
  }
}
